# Campus Black Box - Environment Configuration Example
# Copy this file to .env or set environment variables in your deployment environment

PORT=3000
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
DEMO_PASSWORD=DemoPass123!

# Demo Mode Configuration
# When set to true, enables staff quick-fill credentials on /staff/login and shows the demo data banner.
# Never enabled in production environments.
DEMO_MODE=true

# Frontend / Next.js Configuration (for offline Next.js builds)
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_DEV_LOGIN=false
